rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "mujtabacs50@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'product', 'status'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50
        && data.product is string && data.product.size() <= 150
        && data.status in ['New', 'Hot', 'Warm', 'Closed']
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && (!('note' in data) || (data.note is string && data.note.size() <= 1000))
        && (!('value' in data) || (data.value is string && data.value.size() <= 100))
        && (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 100))
        && (!('estimatedKw' in data) || data.estimatedKw is number);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 150
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 150))
        && (!('role' in data) || data.role in ['sales_agent', 'admin']);
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Leads collection:
    // Anyone (website visitors, voice assistant) can submit a new solar quote / survey lead
    // Authenticated users (sales agents, owner) can read, manage, update, and delete leads
    match /leads/{leadId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(leadId) && isValidLead(request.resource.data);
      allow update: if isSignedIn() && isValidId(leadId) && isValidLead(request.resource.data);
      allow delete: if isSignedIn() && isValidId(leadId);
    }

    // User Profiles collection:
    // Only the user themselves or an admin can access their profile
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
